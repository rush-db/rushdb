# Token every client presents (HTTP bearer, PostgreSQL password, Bolt
# credentials). Required: the server refuses the default token in a container.
#   openssl rand -hex 32
RUSHDB_TOKEN=

# Image tag: 3 (latest 3.x), 3.0, or an exact release such as 3.0.1.
RUSHDB_IMAGE_TAG=3

# Host ports, bound to 127.0.0.1 (compose.yaml).
RUSHDB_HTTP_PORT=3000
RUSHDB_PGWIRE_PORT=5432

# Public domain for compose.https.yaml.
RUSHDB_DOMAIN=
