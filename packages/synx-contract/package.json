    "generate:rust": "tsx scripts/generate-rust.ts",
    "generate:rust:check": "tsx scripts/generate-rust.ts --check"
  },
  "devDependencies": {
    "@types/node": "^18.15.11",
    "ajv": "^8.17.1",
    "tsx": "^4.19.2",
    "typescript": "5.7.2"
  },
  "sideEffects": false
}
