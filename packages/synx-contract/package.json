{
  "name": "@rushdb/synx-contract",
  "version": "0.0.0",
  "private": true,
  "description": "Private RushDB Cloud Core <-> Synx destination contract (v1). Never published; not part of the public SDK.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "types:check": "tsc --noEmit",
