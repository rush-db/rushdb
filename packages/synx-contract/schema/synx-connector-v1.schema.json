{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rushdb.com/schemas/synx/connector-v1.json",
  "title": "SynxConnectorV1",
  "description": "Connector capability + configuration descriptor (v1), served by the Synx control-plane connector catalog. The dashboard renders 'add source' flows generically from the declared fields so a freshly deployed connector surfaces in the Cloud UI without a rushdb redeploy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "name", "version", "schemaVersion", "capabilities", "fields"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "capabilities": {
      "$ref": "#/$defs/SynxConnectorCapabilitiesV1"
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SynxConnectorFieldV1"
      }
    },
    "entitlement": {
      "title": "SynxConnectorTierV1",
      "enum": ["free", "paid", "top_tier"]
    },
    "unavailableReason": {
      "type": "string"
    }
  },
  "$defs": {
    "SynxBatchModeV1": {
      "title": "SynxBatchModeV1",
      "enum": ["snapshot", "incremental", "replay"]
    },
    "SynxDeletionModeV1": {
      "title": "SynxDeletionModeV1",
      "enum": ["ignore", "soft_delete", "hard_delete"]
    },
    "SynxConnectorFieldTypeV1": {
      "title": "SynxConnectorFieldTypeV1",
      "enum": ["string", "integer", "boolean", "select"]
    },
    "SynxConnectorCapabilitiesV1": {
      "title": "SynxConnectorCapabilitiesV1",
      "type": "object",
      "additionalProperties": false,
      "required": ["batchModes", "deletionModes", "relationEvidence"],
      "properties": {
        "batchModes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SynxBatchModeV1"
          }
        },
        "deletionModes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SynxDeletionModeV1"
          }
        },
        "relationEvidence": {
          "type": "boolean"
        }
      }
    },
    "SynxConnectorFieldV1": {
      "title": "SynxConnectorFieldV1",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type", "required"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/SynxConnectorFieldTypeV1"
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        },
        "secret": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SynxConnectorFieldOptionV1"
          }
        }
      }
    },
    "SynxConnectorFieldOptionV1": {
      "title": "SynxConnectorFieldOptionV1",
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    }
  }
}
